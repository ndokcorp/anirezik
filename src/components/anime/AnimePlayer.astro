---
import type { Anime } from '../../types/anime';
import { getVideoSources } from '../../lib/providers/video';
import EpisodeSelector from './EpisodeSelector.astro';
import DubSelector from './DubSelector.astro';
import { url } from '../../lib/paths';
import type { VideoSource } from '../../lib/providers/video/types';
import { safeJson } from '../../lib/serialize';
interface Props {
  anime: Pick<Anime, 'id' | 'title' | 'sources'>;
  testSources?: VideoSource[];
}
const { anime, testSources } = Astro.props;
const sources =
  anime.id === 'demo:player' && testSources ? testSources : await getVideoSources(anime.id);
const episodes = [...new Set(sources.map((s) => s.episodeNumber))].sort((a, b) => a - b);
---

<section
  id="anime-player"
  data-player-anime={anime.id}
  class="info-panel player-section"
  aria-labelledby="watch-heading"
>
  <h2 id="watch-heading">{anime.title}</h2>
  {sources.length > 0 ? (
    <div class="anime-player" data-player>
      <div class="video-controls">
        <EpisodeSelector episodes={episodes} />
        <DubSelector variants={[]} />
      </div>
      <div data-video-surface></div>
      <p data-video-credit></p>
      <script type="application/json" data-video-sources set:html={safeJson(sources)} />
    </div>
  ) : (
    <div class="player-placeholder">
      <strong>AniRezik Player</strong>
      <p>
        Просмотр пока недоступен. Здесь появятся серии и выбор озвучки после подключения
        разрешённого источника.
      </p>
      <a class="button button-secondary" href={url('player-test/')}>
        Проверить плеер
      </a>
    </div>
  )}
  {anime.sources.map((source) => (
    <a class="button button-secondary" href={source.url} rel="noopener noreferrer" target="_blank">
      {source.label} ↗
    </a>
  ))}
</section>
<script>
  import { initPlayers, loadPlayerSources } from '../../lib/video-player';
  initPlayers();
  document.querySelectorAll<HTMLElement>('[data-player-anime]').forEach((section) => {
    void loadPlayerSources(section, section.dataset.playerAnime!);
  });
</script>
