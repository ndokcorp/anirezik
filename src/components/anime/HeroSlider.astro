---
import { featuredAnime as slides } from '../../lib/featured-anime';
import { animePath } from '../../data/anime';
import { url } from '../../lib/paths';
import Icon from '../ui/Icon.astro';
import Rating from '../ui/Rating.astro';
import FavoriteButton from '../ui/FavoriteButton.astro';
import { imageUrl, imageFallback } from '../../lib/images';
---

<section class="hero" aria-roledescription="карусель" aria-label="Рекомендуемое аниме" tabindex="0">
  {slides.map((a, i) => (
    <article
      class:list={['hero-slide', { selected: i === 0 }]}
      data-slide={i}
      aria-hidden={i !== 0}
      inert={i !== 0}
    >
      <img
        class="hero-image poster-backdrop"
        data-banner-image
        data-image-alternative={a.posterUrl || undefined}
        src={imageUrl(
          i === 0 ? a.posterDetailUrl || a.poster : imageFallback,
          import.meta.env.BASE_URL,
        )}
        data-slide-image-src={
          i === 0 ? undefined : imageUrl(a.posterDetailUrl || a.poster, import.meta.env.BASE_URL)
        }
        alt=""
        width="1600"
        height="900"
        loading={i === 0 ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={i === 0 ? 'high' : 'auto'}
      />
      <div class="hero-overlay"></div>
      <img
        class="hero-poster"
        src={imageUrl(
          i === 0 ? a.posterDetailUrl || a.poster : imageFallback,
          import.meta.env.BASE_URL,
        )}
        data-slide-image-src={
          i === 0 ? undefined : imageUrl(a.posterDetailUrl || a.poster, import.meta.env.BASE_URL)
        }
        data-image-fallback={imageUrl(imageFallback, import.meta.env.BASE_URL)}
        data-image-alternative={a.posterUrl || undefined}
        alt={`Постер: ${a.title}`}
        width="400"
        height="600"
        loading={i === 0 ? 'eager' : 'lazy'}
        decoding="async"
      />
      <div class="hero-copy">
        <div class="eyebrow">
          <span></span> В ЦЕНТРЕ ВНИМАНИЯ
        </div>
        <div class="hero-meta">
          <span>{a.year}</span>
          <span>{a.type}</span>
          <span>{a.genres[0]}</span>
          {a.ageRating && <span>{a.ageRating}</span>}
        </div>
        <h1 class:list={{ 'long-title': a.title.length > 25 }}>{a.title}</h1>
        <p class="hero-russian">{a.originalTitle}</p>
        <div class="hero-score">
          <Rating score={a.score} />
        </div>
        <p class="hero-description">{a.description}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={url(animePath(a))}>
            <Icon name="arrow" size={18} />
            Подробнее
          </a>
          <FavoriteButton id={a.id} large />
        </div>
      </div>
    </article>
  ))}
  <div class="hero-bottom">
    <div class="slide-dots" aria-label="Выбор слайда">
      {slides.map((a, i) => (
        <button
          class:list={{ active: i === 0 }}
          data-slide-to={i}
          aria-label={`Слайд ${i + 1}: ${a.originalTitle}`}
          aria-pressed={i === 0}
        />
      ))}
    </div>
    <div class="slide-count">
      <span data-current-slide>01</span>
      <span> / {String(slides.length).padStart(2, '0')}</span>
      <button data-prev-slide aria-label="Предыдущий слайд">
        <Icon name="arrow" size={17} />
      </button>
      <button data-next-slide aria-label="Следующий слайд">
        <Icon name="arrow" size={17} />
      </button>
    </div>
  </div>
</section>
