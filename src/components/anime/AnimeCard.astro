---
import type { Anime } from '../../types/anime';
import { url } from '../../lib/paths';
import FavoriteButton from '../ui/FavoriteButton.astro';
import { searchText } from '../../lib/search';
import Poster from '../ui/Poster.astro';
import { animePath } from '../../data/anime';
import Rating from '../ui/Rating.astro';
import CardMeta from '../ui/CardMeta.astro';
interface Props {
  anime: Anime;
}
const { anime: a } = Astro.props;
---

<article
  class="anime-card"
  data-anime-id={a.id}
  data-genres={a.genres.join('|')}
  data-year={a.year}
  data-type={a.type}
  data-status={a.status}
  data-studios={a.studios.join('|')}
  data-score={a.score ?? ''}
  data-title={a.title}
  data-search={searchText(a)}
>
  <a href={url(animePath(a))} class="card-link">
    <Poster
      src={a.poster}
      alternative={a.posterDetailUrl || undefined}
      defer
      alt={
        a.imageLicenseStatus === 'original-ai'
          ? `AI-иллюстрация: ${a.title}, не официальный постер`
          : a.posterAttribution
            ? `Постер ${a.title}`
            : `Фирменная заглушка: ${a.title}`
      }
    />
    {a.imageLicenseStatus === 'original-ai' && (
      <span class="art-label">AI · НЕОФИЦИАЛЬНЫЙ АРТ</span>
    )}
    <div class="card-shade"></div>
    <Rating score={a.score} />
    <CardMeta ageRating={a.ageRating} episodes={a.episodes} type={a.type} />
    <div class="card-info">
      <span class="card-original">{a.originalTitle}</span>
      <h3>{a.title}</h3>
      <p>
        {a.type} <span>·</span> {a.year ?? '—'}
      </p>
    </div>
  </a>
  <FavoriteButton id={a.id} />
</article>
