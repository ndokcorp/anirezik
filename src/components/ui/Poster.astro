---
import RemotePoster from './RemotePoster.astro';
interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  defer?: boolean;
  alternative?: string;
}
const { src, alt, class: className, loading = 'lazy', defer = false, alternative } = Astro.props;
---

<RemotePoster
  src={src}
  alt={alt}
  class={className}
  loading={loading}
  defer={defer}
  alternative={alternative}
/>
