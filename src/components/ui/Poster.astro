---
import RemotePoster from './RemotePoster.astro';
interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  defer?: boolean;
  alternative?: string;
  recovery?: string;
}
const {
  src,
  alt,
  class: className,
  loading = 'lazy',
  defer = false,
  alternative,
  recovery,
} = Astro.props;
---

<RemotePoster
  src={src}
  alt={alt}
  class={className}
  loading={loading}
  defer={defer}
  recovery={recovery}
  alternative={alternative}
/>
