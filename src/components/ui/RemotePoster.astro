---
import { imageUrl, imageFallback } from '../../lib/images';
interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  defer?: boolean;
  alternative?: string;
  recovery?: string;
}
const {
  src,
  alt,
  class: className,
  loading = 'lazy',
  defer = false,
  alternative,
  recovery,
} = Astro.props;
---

<img
  class={className}
  src={imageUrl(defer ? imageFallback : src, import.meta.env.BASE_URL)}
  data-image-src={defer ? imageUrl(src, import.meta.env.BASE_URL) : undefined}
  data-image-recovery={
    recovery && recovery !== src && recovery !== alternative
      ? imageUrl(recovery, import.meta.env.BASE_URL)
      : undefined
  }
  data-image-fallback={imageUrl(imageFallback, import.meta.env.BASE_URL)}
  data-image-alternative={
    alternative && alternative !== src ? imageUrl(alternative, import.meta.env.BASE_URL) : undefined
  }
  alt={alt}
  width="400"
  height="600"
  loading={loading}
  decoding="async"
  style="object-fit:cover"
/>
