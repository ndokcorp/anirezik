---
import updates from '../../data/site-updates.json';
import Icon from '../ui/Icon.astro';
---

<div class="community-links" aria-label="Сообщество AniRezik">
  <button class="community-icon" aria-label="Новости сайта" data-open-news>
    <Icon name="news" size={18} />
  </button>
</div>
<dialog id="site-news" class="updates-dialog">
  <div class="dialog-top">
    <h2>Новости AniRezik</h2>
    <button class="icon-button" data-close-news aria-label="Закрыть новости">
      <Icon name="close" />
    </button>
  </div>
  {updates.map((item) => (
    <article>
      <span class="eyebrow">{item.version}</span>
      <h3>{item.title}</h3>
      <p>{item.text}</p>
    </article>
  ))}
</dialog>
