---
import Icon from '../ui/Icon.astro';
import { url } from '../../lib/paths';
const { active } = Astro.props;
const current = Astro.url.pathname.endsWith('/history/') ? 'history' : active;
---

<nav class="mobile-nav" aria-label="Мобильная навигация">
  {[
    ['home', '', 'home', 'Главная'],
    ['catalog', 'catalog/', 'compass', 'Каталог'],
    ['history', 'history/', 'clock', 'История'],
    ['search', '', 'search', 'Поиск'],
    ['collection', 'collection/', 'collection', 'Коллекция'],
    ['profile', 'profile/', 'user', 'Войти'],
  ].map(([id, path, icon, label]) =>
    id === 'search' ? (
      <button
        type="button"
        class="mobile-search-center"
        data-open-search
        aria-label="Открыть поиск"
      >
        <Icon name="search" />
      </button>
    ) : (
      <a
        href={url(path)}
        aria-label={id === 'history' ? 'История просмотров' : undefined}
        class:list={{ active: current === id || (id === 'collection' && current === 'favorites') }}
        aria-current={current === id ? 'page' : undefined}
      >
        <Icon name={icon} />
        <span>{label}</span>
      </a>
    ),
  )}
</nav>
