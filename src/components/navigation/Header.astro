---
import HeaderCommunity from './HeaderCommunity.astro';
import Logo from './Logo.astro';
import SearchBar from '../ui/SearchBar.astro';
import Icon from '../ui/Icon.astro';
import { url } from '../../lib/paths';
const { active = 'home' } = Astro.props;
---

<header class="header">
  <div class="brand-cluster">
    <Logo />
    <HeaderCommunity />
  </div>
  <nav class="desktop-nav" aria-label="Основная навигация">
    <span class="nav-highlight" aria-hidden="true"></span>
    {[
      ['home', '', 'Главная'],
      ['catalog', 'catalog/', 'Каталог'],
      ['schedule', 'schedule/', 'Расписание'],
    ].map(([id, path, label]) => (
      <a
        class:list={{ active: active === id }}
        href={url(path)}
        aria-current={active === id ? 'page' : undefined}
      >
        {label}
      </a>
    ))}
  </nav>
  {Astro.url.pathname.replace(/\/$/, '').endsWith('/catalog') ? (
    <div class="header-spacer"></div>
  ) : (
    <SearchBar />
  )}
  <a class="icon-button desktop-favorite" href={url('favorites/')} aria-label="Избранное">
    <Icon name="bookmark" />
  </a>
  {!Astro.url.pathname.replace(/\/$/, '').endsWith('/catalog') && (
    <button class="icon-button mobile-search" aria-label="Открыть поиск" data-open-search>
      <Icon name="search" />
    </button>
  )}
  <button
    class="icon-button menu-toggle"
    aria-label="Открыть меню"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <Icon name="menu" />
  </button>
</header>
<dialog id="mobile-menu" class="menu-dialog">
  <div class="dialog-top">
    <span>Навигация</span>
    <button class="icon-button" data-close-menu aria-label="Закрыть меню">
      <Icon name="close" />
    </button>
  </div>
  <nav>
    {[
      ['', 'Главная'],
      ['catalog/', 'Каталог'],
      ['schedule/', 'Расписание'],
      ['favorites/', 'Избранное'],
      ['profile/', 'Профиль'],
    ].map(([path, label]) => (
      <a href={url(path)}>
        {label}
        <Icon name="arrow" />
      </a>
    ))}
  </nav>
</dialog>
