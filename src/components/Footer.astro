---
import Logo from './navigation/Logo.astro';
import { url } from '../lib/paths';
const navigation = [
  ['', 'Главная'],
  ['catalog/', 'Каталог Аниме'],
  ['schedule/', 'Расписание Выходов'],
  ['collection/', 'Коллекция Аниме'],
  ['history/', 'История Просмотров'],
  ['favorites/', 'Избранные Аниме'],
  ['news/', 'Новости Сайта'],
];
const information = [
  ['faq/', 'Вопросы и Ответы'],
  ['terms/', 'Пользовательское Соглашение'],
  ['privacy/', 'Согласие на обработку данных'],
  ['rules/', 'Правила сайта'],
  ['copyright/', 'Правообладателям'],
];
---

<footer class="footer site-footer">
  <div class="footer-brand">
    <Logo />
    <p>Смотри аниме и делись впечатлениями.</p>
    <a href={url('about/#posters')}>Источники изображений</a>
  </div>
  <nav aria-label="Навигация внизу сайта">
    <h2>НАВИГАЦИЯ</h2>
    {navigation.map(([path, label]) => (
      <a href={url(path)}>{label}</a>
    ))}
  </nav>
  <nav aria-label="Информация">
    <h2>ИНФОРМАЦИЯ</h2>
    {information.map(([path, label]) => (
      <a href={url(path)}>{label}</a>
    ))}
  </nav>
  <div class="footer-contacts">
    <h2>СВЯЗИ</h2>
    <a href="mailto:ndokcooperation@gmail.com">По всем вопросам: ndokcooperation@gmail.com</a>
    <a href="https://t.me/anirezik" target="_blank" rel="noopener noreferrer">
      Наш Telegram-канал
    </a>
    <a href="https://www.tiktok.com/@anirezik" target="_blank" rel="noopener noreferrer">
      Тик-Ток: @anirezik
    </a>
    <a href="https://www.youtube.com/@neumniy" target="_blank" rel="noopener noreferrer">
      Youtube Автора
    </a>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} AniRezik</span>
    <div>
      <p>
        Данные о тайтлах —{' '}
        <a href="https://shikimori.io/" target="_blank" rel="noopener noreferrer">
          Shikimori
        </a>
      </p>
      <p>
        <strong>18+</strong> Сайт содержит материалы для взрослой аудитории
      </p>
    </div>
  </div>
</footer>
