---
import Logo from './navigation/Logo.astro';
import Icon from './ui/Icon.astro';
import { url } from '../lib/paths';
const navigation = [
  ['', 'Главная'],
  ['catalog/', 'Каталог Аниме'],
  ['schedule/', 'Расписание Выходов'],
  ['collection/', 'Коллекция Аниме'],
  ['history/', 'История Просмотров'],
  ['favorites/', 'Избранные Аниме'],
  ['news/', 'Новости Сайта'],
];
const information = [
  ['faq/', 'Вопросы и Ответы'],
  ['terms/', 'Пользовательское Соглашение'],
  ['privacy/', 'Согласие на обработку данных'],
  ['rules/', 'Правила сайта'],
  ['copyright/', 'Правообладателям'],
];
---

<footer class="footer site-footer">
  <div class="footer-brand">
    <Logo />
    <p>Смотри аниме и делись впечатлениями.</p>
  </div>
  <nav aria-label="Навигация внизу сайта">
    <h2>
      <Icon name="compass" size={20} /> НАВИГАТОР
    </h2>
    {navigation.map(([path, label]) => (
      <a href={url(path)}>{label}</a>
    ))}
  </nav>
  <nav aria-label="Информация">
    <h2>
      <Icon name="info" size={20} /> ИНФОРМАЦИЯ
    </h2>
    {information.map(([path, label]) => (
      <a href={url(path)}>{label}</a>
    ))}
  </nav>
  <div class="footer-contacts">
    <h2>
      <Icon name="support" size={20} /> ПОДДЕРЖКА
    </h2>
    {[
      ['mail', 'mailto:ndokcooperation@gmail.com', 'По всем вопросам', 'ndokcooperation@gmail.com'],
      ['telegram', 'https://t.me/anirezik', 'Наш Telegram-канал', '@anirezik'],
      ['tiktok', 'https://www.tiktok.com/@anirezik', 'Тик-Ток', '@anirezik'],
      ['youtube', 'https://www.youtube.com/@neumniy', 'YouTube автора', '@neumniy'],
    ].map(([icon, href, label, value]) => (
      <a
        class={`contact-link contact-${icon}`}
        href={href}
        target={icon === 'mail' ? undefined : '_blank'}
        rel={icon === 'mail' ? undefined : 'noopener noreferrer'}
      >
        <Icon name={icon} size={23} />
        <span>
          <small>{label}</small>
          <strong>{value}</strong>
        </span>
      </a>
    ))}
  </div>
  <div class="footer-bottom">
    <div class="footer-copyright">
      <span>© {new Date().getFullYear()} AniRezik</span>
      <p>AniRezik не размещает видео и не хранит видеофайлы.</p>
    </div>
    <div>
      <p>
        Данные о тайтлах —{' '}
        <a href="https://shikimori.io/" target="_blank" rel="noopener noreferrer">
          Shikimori
        </a>
      </p>
      <p>
        <strong>18+</strong> Сайт содержит материалы для взрослой аудитории
      </p>
    </div>
  </div>
</footer>
