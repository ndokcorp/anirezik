---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/paths';
---

<Layout title="Расписание" active="schedule">
  <div class="page-heading">
    <span class="eyebrow schedule-eyebrow">ОЖИДАНИЕ НОВЫХ АНИМЕ</span>
    <h1>Расписание</h1>
  </div>
  <div class="empty-state">
    <div class="empty-icon">◷</div>
    <h2>Скоро здесь будет расписание</h2>
    <p>
      Подключим календарь, когда появится надёжный источник дат выхода. А пока можно выбрать историю
      из каталога.
    </p>
    <a class="button button-primary" href={url('catalog/')}>
      Открыть каталог
    </a>
  </div>
</Layout>
<style>
  .schedule-eyebrow {
    font-size: clamp(15px, 1.3vw, 19px);
    font-weight: 800;
    color: #e7364b;
    letter-spacing: 0.12em;
  }
</style>
