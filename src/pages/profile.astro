---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/paths';
---

<Layout title="Профиль" active="profile" noindex>
  <div class="page-heading">
    <span class="eyebrow">ANIREZIK BETA</span>
    <h1>Профиль</h1>
  </div>
  <div class="empty-state">
    <div class="empty-icon">◉</div>
    <h2>В разработке</h2>
    <p>
      Аккаунты и синхронизация коллекции появятся позже. Пока ваше избранное сохраняется локально на
      этом устройстве.
    </p>
    <a class="button button-primary" href={url('favorites/')}>
      Моё избранное
    </a>
  </div>
</Layout>
