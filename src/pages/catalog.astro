---
import Layout from '../layouts/Layout.astro';
import AnimeGrid from '../components/anime/AnimeGrid.astro';
import FilterPanel from '../components/FilterPanel.astro';
import Icon from '../components/ui/Icon.astro';
import { anime } from '../data/anime';
---

<Layout title="Каталог" active="catalog">
  <div class="page-heading">
    <span class="eyebrow">НАХОДИ АНИМЕ ПОД СЕБЯ</span>
    <h1>Каталог аниме</h1>
    <p>Поиск аниме в AniRezik.</p>
  </div>
  <div class="catalog-toolbar">
    <label class="catalog-search-wrap">
      <Icon name="search" />
      <input
        class="catalog-search"
        id="catalog-search"
        type="search"
        placeholder="Название на русском или в оригинале"
        aria-label="Поиск в каталоге"
      />
    </label>
    <button
      class="button button-secondary filter-toggle"
      aria-label="Фильтры"
      disabled
      aria-controls="filter-panel"
      aria-expanded="false"
    >
      <Icon name="filter" size={18} />
    </button>
  </div>
  <FilterPanel />
  <p class="result-count" aria-live="polite">
    Найдено: {anime.length}
  </p>
  <AnimeGrid items={anime.slice(0, 24)} id="catalog-grid" />
  <div class="empty-state" id="catalog-empty" hidden>
    <div class="empty-icon">⌕</div>
    <h2>Ничего не найдено</h2>
    <p>Попробуйте другое название или сбросьте фильтры.</p>
    <button class="button button-secondary" data-reset>
      Сбросить фильтры
    </button>
  </div>
  <button class="button button-secondary load-more" id="load-more" hidden={anime.length <= 24}>
    Показать ещё
  </button>
</Layout>
