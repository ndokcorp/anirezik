---
import Layout from '../layouts/Layout.astro';
import HeroSlider from '../components/anime/HeroSlider.astro';
import GenreFilter from '../components/GenreFilter.astro';
import AnimeSection from '../components/anime/AnimeSection.astro';
import { anime, genres } from '../data/anime';
import { url } from '../lib/paths';
---

<Layout>
  <HeroSlider />
  <GenreFilter />
  <AnimeSection
    title="Популярное сейчас"
    subtitle="Редакционная подборка · данные Shikimori"
    items={[52299, 38000, 40748, 16498, 44511, 20]
      .map((id) => anime.find((a) => a.shikimoriId === id))
      .filter((a): a is (typeof anime)[number] => !!a)}
    id="popular"
  />
  <div class="editorial-strip">
    <span class="editorial-symbol">✦</span>
    <div>
      <span class="eyebrow">НАЙДИ СВОЮ ИСТОРИЮ</span>
      <h2>Целый мир. По ту сторону экрана.</h2>
      <p>От захватывающих сражений до историй, которые остаются с тобой.</p>
    </div>
    <a class="button button-secondary" href={url('catalog/')}>
      Исследовать каталог <span>↗</span>
    </a>
  </div>
  <AnimeSection
    title="Новинки сезона"
    subtitle="Дата начала — в сезоне последнего обновления каталога"
    items={anime.filter((a) => a.isNew).slice(0, 6)}
  />
  <AnimeSection
    title="Полнометражные истории"
    subtitle="Один вечер — тысяча эмоций"
    items={anime.filter((a) => a.type === 'Фильм').slice(0, 6)}
    href={`catalog/?type=${encodeURIComponent('Фильм')}`}
  />
  <AnimeSection
    title="Сейчас выходят"
    subtitle="Статус по последнему снимку Shikimori"
    items={anime.filter((a) => a.sourceStatus === 'ongoing').slice(0, 6)}
  />
  <AnimeSection
    title="Завершённые истории"
    items={anime.filter((a) => a.sourceStatus === 'released').slice(0, 6)}
  />
  <AnimeSection
    title="Стоит открыть"
    subtitle="Выбор редакции AniRezik"
    items={[52991, 33352, 9253, 50265, 20583, 30276]
      .map((id) => anime.find((a) => a.shikimoriId === id))
      .filter((a): a is (typeof anime)[number] => !!a)}
  />
  <section class="genres-section">
    <div class="section-heading">
      <h2>Какое сегодня настроение?</h2>
      <a href={url('genres/')} class="text-link">
        Все жанры →
      </a>
    </div>
    <div class="genre-tiles">
      {genres.slice(0, 6).map((g, i) => (
        <a href={url(`catalog/?genre=${encodeURIComponent(g)}`)}>
          <span class="genre-number">0{i + 1}</span>
          <h3>{g}</h3>
          <span>Открыть подборку ↗</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
