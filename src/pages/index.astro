---
import Layout from '../layouts/Layout.astro';
import HeroSlider from '../components/anime/HeroSlider.astro';
import AnimeSection from '../components/anime/AnimeSection.astro';
import { anime } from '../data/anime';
---

<Layout>
  <HeroSlider />
  <AnimeSection
    title="Популярное сейчас"
    subtitle="Редакционная подборка · данные Shikimori"
    items={[52299, 38000, 40748, 16498, 44511, 20]
      .map((id) => anime.find((a) => a.shikimoriId === id))
      .filter((a): a is (typeof anime)[number] => !!a)}
    id="popular"
  />
  <AnimeSection
    title="Новинки сезона"
    subtitle="Дата начала — в сезоне последнего обновления каталога"
    items={anime.filter((a) => a.isNew).slice(0, 6)}
  />
  <AnimeSection
    title="Полнометражные истории"
    subtitle="Один вечер — тысяча эмоций"
    items={anime.filter((a) => a.type === 'Фильм').slice(0, 6)}
    href={`catalog/?type=${encodeURIComponent('Фильм')}`}
  />
  <AnimeSection
    title="Сейчас выходят"
    subtitle="Статус по последнему снимку Shikimori"
    items={anime.filter((a) => a.sourceStatus === 'ongoing').slice(0, 6)}
  />
  <AnimeSection
    title="Завершённые истории"
    items={anime.filter((a) => a.sourceStatus === 'released').slice(0, 6)}
  />
  <AnimeSection
    title="Стоит открыть"
    subtitle="Выбор редакции AniRezik"
    items={[52991, 33352, 9253, 50265, 20583, 30276]
      .map((id) => anime.find((a) => a.shikimoriId === id))
      .filter((a): a is (typeof anime)[number] => !!a)}
  />
</Layout>
