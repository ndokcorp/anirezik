---
import Layout from '../layouts/Layout.astro';
import { collectionLabels } from '../lib/local-library';
import Icon from '../components/ui/Icon.astro';
const icons: Record<string, string> = {
  watching: 'play',
  completed: 'check',
  planned: 'bookmark',
  rewatching: 'clock',
};
---

<Layout title="Ваша коллекция" active="collection" noindex>
  <section data-library-page="collection">
    <div class="page-heading">
      <h1>Ваша коллекция</h1>
    </div>
    <div class="collection-filter list-picker" data-collection-filter>
      <button
        class="button button-secondary"
        type="button"
        aria-expanded="false"
        aria-controls="collection-filter-options"
      >
        <Icon name="filter" size={18} />
        <span>Фильтр</span>
        <strong data-selected-list>Смотрю</strong>
        <Icon name="arrow" size={16} />
      </button>
      <div
        class="list-options"
        id="collection-filter-options"
        role="group"
        aria-label="Фильтр коллекции"
        hidden
      >
        <button
          class="button button-secondary"
          data-collection-status="favorites"
          aria-pressed="false"
        >
          <Icon name="star" size={20} />
          <span class="list-label">Избранные аниме</span>
        </button>
        {Object.entries(collectionLabels).map(([id, label]) => (
          <button
            class="button button-secondary"
            data-collection-status={id}
            aria-pressed={id === 'watching'}
          >
            <Icon name={icons[id]} size={20} />
            <span class="list-label">{label}</span>
          </button>
        ))}
      </div>
    </div>
    <p class="collection-count" data-library-count></p>
    <p data-library-status role="status"></p>
    <div class="anime-grid"></div>
    <button class="button button-secondary load-more" data-library-more hidden>
      Показать ещё
    </button>
    <noscript>Для локальных списков включите JavaScript.</noscript>
  </section>
</Layout>
