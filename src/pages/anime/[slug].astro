---
import Layout from '../../layouts/Layout.astro';
import Banner from '../../components/anime/Banner.astro';
import Poster from '../../components/ui/Poster.astro';
import { anime, animeByShikimoriId, staticPageIds, animePath } from '../../data/anime';
import { url } from '../../lib/paths';
import FavoriteButton from '../../components/ui/FavoriteButton.astro';
import AnimeSection from '../../components/anime/AnimeSection.astro';
import { chronology, similarAnime } from '../../lib/detail-sections';
import { ageLabel } from '../../lib/card-meta';
import AnimePlayer from '../../components/anime/AnimePlayer.astro';
import { displayDate } from '../../lib/dates';
import Rating from '../../components/ui/Rating.astro';
import { descriptions } from '../../lib/descriptions';
export function getStaticPaths() {
  return anime
    .filter((a) => staticPageIds.has(a.shikimoriId))
    .map((a) => ({ params: { slug: a.slug }, props: { a } }));
}
const { a } = Astro.props;
const related = similarAnime(a);
const timeline = chronology(a);
---

<Layout
  title={a.title}
  description={
    a.description ||
    `${a.title}: информация, студии, жанры, эпизоды и оценка пользователей Shikimori.`
  }
  active="catalog"
>
  <Banner anime={a} />
  <article class="detail-content" data-viewed-id={a.id} data-viewed-title={a.title}>
    <aside class="detail-sidebar">
      <Poster
        class="detail-poster"
        src={a.posterDetailUrl || a.poster}
        alternative={a.posterUrl || undefined}
        alt={
          a.imageLicenseStatus === 'original-ai'
            ? 'AI-иллюстрация: ' + a.title + ' · не официальный постер'
            : 'Постер: ' + a.title
        }
      />
      <div class="detail-actions">
        <FavoriteButton id={a.id} large />
        <button class="button button-secondary" data-share-anime>
          Поделиться
        </button>
      </div>
    </aside>
    <div class="detail-copy">
      <span class="eyebrow">ANIREZIK / КАТАЛОГ</span>
      <h1>{a.title}</h1>
      <p class="original-title">{a.originalTitle}</p>
      <div class="detail-tags">
        <span>{a.year ?? '—'}</span>
        <span>{a.type}</span>
        <span>{a.status}</span>
        {ageLabel(a.ageRating) && <span>{ageLabel(a.ageRating)}</span>}
        <span>
          {a.episodes === null
            ? 'Серии: —'
            : a.type === 'Фильм'
              ? 'Полнометражный'
              : `${a.episodes} серий`}
        </span>
        {a.genres.map((g) => (
          <a href={url(`catalog/?genre=${encodeURIComponent(g)}`)}>{g}</a>
        ))}
      </div>
      <p
        class="description"
        data-description-id={
          !a.description && descriptions.has(a.shikimoriId) ? a.shikimoriId : undefined
        }
      >
        {a.description || 'Описание пока недоступно.'}
      </p>
      {!a.description && (
        <a class="source-note" href={a.sourceUrl} target="_blank" rel="noopener noreferrer">
          Описание на Shikimori ↗
        </a>
      )}
      {a.description && <p class="source-note">Описание редакции AniRezik</p>}
      <a class="button button-primary player-jump" href="#anime-player">
        К плееру <span>· готовится</span>
      </a>
    </div>
  </article>
  <section class="info-panel">
    <h2>Сведения об аниме</h2>
    <dl class="anime-facts">
      <div>
        <dt>Оригинальное название</dt>
        <dd>{a.originalTitle}</dd>
      </div>
      {a.englishTitle && (
        <div>
          <dt>Английское название</dt>
          <dd>{a.englishTitle}</dd>
        </div>
      )}
      {a.japaneseTitle && (
        <div>
          <dt>Японское название</dt>
          <dd>{a.japaneseTitle}</dd>
        </div>
      )}
      <div>
        <dt>Студии анимации</dt>
        <dd>
          {a.studios.length
            ? a.studios.map((studio) => (
                <a href={url(`catalog/?studio=${encodeURIComponent(studio)}`)}>{studio}</a>
              ))
            : '—'}
        </dd>
      </div>
      <div>
        <dt>Возрастная классификация</dt>
        <dd>{a.ageRating ?? '—'}</dd>
      </div>
      <div>
        <dt>Продолжительность эпизода</dt>
        <dd>{a.duration ? `${a.duration} мин` : '—'}</dd>
      </div>
      <div>
        <dt>Начало показа</dt>
        <dd>{displayDate(a.airedOn)}</dd>
      </div>
      <div>
        <dt>Окончание показа</dt>
        <dd>{displayDate(a.releasedOn)}</dd>
      </div>
      {a.themes.length > 0 && (
        <div>
          <dt>Тематики и аудитория</dt>
          <dd>{a.themes.join(', ')}</dd>
        </div>
      )}
      <div>
        <dt>Всего по данным источника</dt>
        <dd>{a.episodes ?? '—'}</dd>
      </div>
      <div>
        <dt>Вышло по данным источника</dt>
        <dd>{a.episodesAired ?? '—'}</dd>
      </div>
      <div>
        <dt>Статус</dt>
        <dd>{a.status}</dd>
      </div>
      {a.nextEpisodeAt && (
        <div>
          <dt>Следующий эпизод</dt>
          <dd>{displayDate(a.nextEpisodeAt)}</dd>
        </div>
      )}
    </dl>
    <p class="source-note">
      Данные обновлены {displayDate(a.fetchedAt)} ·{' '}
      <a href={a.sourceUrl} target="_blank" rel="noopener noreferrer">
        Открыть на Shikimori ↗
      </a>
      . Студии анимации указаны отдельно от будущих студий озвучки.
    </p>
  </section>
  <AnimePlayer anime={a} />
  {timeline.length > 1 && (
    <section class="info-panel">
      <h2>Хронология франшизы</h2>
      <p class="source-note">
        Известные связи, порядок по датам выхода. Не гарантированный порядок просмотра.
      </p>
      <ol class="franchise-timeline">
        {timeline.map((item) => (
          <li class:list={{ current: item.current }}>
            <span>
              {displayDate(item.date)} · {item.type}
            </span>
            <a href={item.href} aria-current={item.current ? 'page' : undefined}>
              {item.title}
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}
  {a.related.length > 0 && (
    <section class="info-panel">
      <h2>Связанные аниме и сезоны</h2>
      <ul class="related-list">
        {[...a.related]
          .sort(
            (x, y) =>
              ['prequel', 'sequel'].indexOf(y.relationKind) -
              ['prequel', 'sequel'].indexOf(x.relationKind),
          )
          .map((item) => {
            const local = animeByShikimoriId.get(item.shikimoriId);
            return (
              <li>
                <span>{item.relation}</span>
                <a
                  class="related-link"
                  aria-label={local ? item.title : `${item.title} ↗ Shikimori`}
                  href={local ? url(animePath(local)) : item.sourceUrl}
                  target={local ? undefined : '_blank'}
                  rel={local ? undefined : 'noopener noreferrer'}
                >
                  {local && (
                    <span class="related-art">
                      <Poster
                        class="related-poster"
                        src={local.poster}
                        alternative={local.posterDetailUrl || undefined}
                        defer
                        alt={
                          local.imageLicenseStatus === 'original-ai'
                            ? `AI-иллюстрация: ${item.title}, не официальный постер`
                            : local.posterUrl
                              ? `Постер: ${item.title}`
                              : `Фирменная заглушка: ${item.title}`
                        }
                      />
                      <Rating score={local.score} small />
                    </span>
                  )}
                  <span class="related-copy">
                    {item.title}
                    {!local && ' ↗ Shikimori'}
                    {local?.imageLicenseStatus === 'original-ai' && (
                      <small>AI · НЕОФИЦИАЛЬНЫЙ АРТ</small>
                    )}
                  </span>
                </a>
              </li>
            );
          })}
      </ul>
    </section>
  )}
  <AnimeSection
    title="Похожие аниме"
    subtitle="Совпадение жанров в каталоге AniRezik"
    items={related}
  />
  <section class="info-panel comments-placeholder">
    <h2>Комментарии</h2>
    <p>Обсуждения появятся в одной из следующих версий.</p>
  </section>
</Layout>
