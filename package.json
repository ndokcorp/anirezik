{
  "name": "anirezik",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "node scripts/validate-aniliberty-index.ts && node scripts/validate-kodik-mappings.ts && node scripts/validate-kodik-cache.ts && astro check && tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "format": "prettier --write .",
    "sync:anime": "node scripts/sync-anime.ts",
    "test:api": "node --test tests/api.integration.test.ts",
    "sync:full": "node scripts/sync-anime.ts --full",
    "dev:posters": "node scripts/dev-posters.mjs",
    "test:posters:live": "node scripts/verify-remote-posters.mjs",
    "test:posters:surfaces": "node scripts/verify-poster-surfaces.mjs",
    "sync:descriptions": "node scripts/sync-descriptions.ts",
    "sync:aniliberty": "node scripts/sync-aniliberty-index.ts",
    "kodik:plan": "node scripts/sync-kodik.ts --plan",
    "kodik:sync": "node scripts/sync-kodik.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.2",
    "hls.js": "^1.7.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
